# Example option file for trying out `conm mysql import`:
#
#   conm mysql import --path test/e2e/testdata/mysql/my.cnf --show
#
# [client] and [mysql] together are one connection, named "client". Every
# [client<suffix>] group is another one, the one `mysql --defaults-group-suffix`
# opens, and inherits the options of [client]. The first two connections match
# the containers in docker-compose.yml.

# Password in the file: it goes to the keyring on import.
[client]
host=localhost
port=3306
user=mysql
password=my-s3cret

[mysql]
database=mysql_test

# Overrides the port, the user and the password it would inherit from [client].
[client_noauth]
port=3307
user=root
password=
ssl-mode=DISABLED

# Inherits user and password from [client]; charset has no field in conm and is ignored.
[client_reports]
host=reports.internal
database=warehouse
default-character-set=utf8mb4

# Needs a certificate file: cannot be imported, only the TLS mode is supported yet.
[client_cloud]
host=db.example.com
ssl-mode=VERIFY_IDENTITY
ssl-ca=/etc/ssl/certs/ca.pem

# Server options: not a connection.
[mysqld]
port=3306
