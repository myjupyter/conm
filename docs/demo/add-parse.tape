Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 12
Set Framerate 20
Set TypingSpeed 45ms
Set Theme "Catppuccin Mocha"

Type 'conm postgres add "psql -h localhost -p 15432 -U demo orders"'
Sleep 300ms
Enter
Sleep 2500ms

Type "jjjj"
Sleep 300ms
Type "i"
Sleep 120ms
Type "demo-secret"
Sleep 150ms
Enter
Sleep 250ms
Type "jj"
Sleep 300ms
Type "hh"
Sleep 600ms

Tab
Sleep 300ms
Tab
Sleep 600ms
Type "i"
Sleep 120ms
Type "orders-psql"
Sleep 150ms
Enter
Sleep 250ms
Enter
Sleep 1500ms
Type "p"
Sleep 2000ms
Type "q"
Sleep 800ms
