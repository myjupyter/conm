Output transport-ssh.gif

Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 12
Set Framerate 20
Set TypingSpeed 45ms
Set Theme "Catppuccin Mocha"

Hide
Type `D="$XDG_CONFIG_HOME/conm/default" && mkdir -p "$D" && true && clear`
Enter
Sleep 500ms
Show

Type "conm ssh add"
Sleep 300ms
Enter
Sleep 1500ms
Type "i"
Sleep 120ms
Type "localhost"
Sleep 150ms
Enter
Sleep 300ms
Type "i"
Sleep 120ms
Type "2222"
Sleep 150ms
Enter
Sleep 300ms
Type "i"
Sleep 120ms
Type "demo"
Sleep 150ms
Enter
Sleep 300ms
Type "l"
Sleep 400ms
Type "l"
Sleep 600ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "i"
Sleep 120ms
Type "demo-secret"
Sleep 150ms
Enter
Sleep 300ms
Type "p"
Sleep 2500ms
Tab
Sleep 800ms
Tab
Sleep 800ms
Type "i"
Sleep 300ms
Backspace 16
Sleep 300ms
Type "bastion"
Sleep 150ms
Enter
Sleep 600ms
Enter
Sleep 2000ms
Type "q"
Sleep 800ms
