Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 760
Set Padding 12
Set Framerate 20
Set TypingSpeed 45ms
Set Theme "Catppuccin Mocha"
Env COLORTERM "truecolor"

Hide
Type `D="$XDG_CONFIG_HOME/conm/default" && mkdir -p "$D" && cp customise/postgres.toml "$D/postgres.toml" && clear`
Enter
Sleep 500ms

Hide
Type `cp customise/1-default.toml "$XDG_CONFIG_HOME/conm/conm.toml" && clear && conm`
Enter
Sleep 2500ms
Type "p"
Sleep 2500ms
Type "jp"
Sleep 2500ms
Type "jj"
Sleep 800ms
Show
Sleep 300ms
Screenshot customise-1-default.png
Sleep 300ms
Hide
Type "q"
Sleep 800ms

Hide
Type `cp customise/2-shape.toml "$XDG_CONFIG_HOME/conm/conm.toml" && clear && conm`
Enter
Sleep 2500ms
Type "p"
Sleep 2500ms
Type "jp"
Sleep 2500ms
Type "jj"
Sleep 800ms
Show
Sleep 300ms
Screenshot customise-2-shape.png
Sleep 300ms
Hide
Type "q"
Sleep 800ms

Hide
Type `cp customise/3-accent.toml "$XDG_CONFIG_HOME/conm/conm.toml" && clear && conm`
Enter
Sleep 2500ms
Type "p"
Sleep 2500ms
Type "jp"
Sleep 2500ms
Type "jj"
Sleep 800ms
Show
Sleep 300ms
Type "ss"
Sleep 1200ms
Tab
Sleep 400ms
Tab
Sleep 400ms
Enter
Sleep 800ms
Screenshot customise-3-accent.png
Sleep 300ms
Type "q"
Sleep 500ms
Hide
Type "q"
Sleep 800ms

Hide
Type `cp customise/4-palettes.toml "$XDG_CONFIG_HOME/conm/conm.toml" && clear && conm`
